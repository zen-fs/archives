{
	"name": "@zenfs/archives",
	"version": "1.5.0",
	"description": "ZenFS archive backends",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"keywords": [
		"filesystem",
		"node",
		"storage"
	],
	"type": "module",
	"homepage": "https://github.com/zen-fs/archives",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zen-fs/archives.git"
	},
	"bugs": {
		"url": "https://github.com/zen-fs/archives/issues"
	},
	"engines": {
		"node": ">= 20"
	},
	"exports": {
		".": "./dist/index.js",
		"./*.js": "./dist/*.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"dist",
		"license.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src",
		"test": "npx -s zenfs-test -abc",
		"test:perf": "zbench",
		"build": "tsc -p tsconfig.json",
		"build:test-files": "node tests/build.ts",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@zenfs/devel": "^0.1.0",
		"eslint": "^10.1.0",
		"ioium": "^1.8.0",
		"prettier": "^3.2.5",
		"typedoc": "^0.28.18",
		"typescript": "^6.0.0",
		"zbench-js": "^0.2.0"
	},
	"peerDependencies": {
		"@zenfs/core": "^2.8.3",
		"kerium": "^1.4.2",
		"memium": "^1.0.0",
		"utilium": "^3.0.0"
	},
	"dependencies": {
		"fflate": "^0.8.2"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 180,
		"arrowParens": "avoid"
	},
	"allowScripts": {
		"esbuild": true
	}
}
